{
  "manifest_version": 3,
  "name": "Lens for Force of Will",
  "short_name": "FoW Lens",
  "version": "0.1.0",
  "description": "Show high resolution Force of Will card overlays on YouTube and Twitch.",
  "homepage_url": "https://github.com/CHANGE-ME/fow_lense",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/toolbar16.png",
    "32": "icons/toolbar32.png",
    "48": "icons/toolbar48.png",
    "128": "icons/toolbar128.png"
  },
  "permissions": [
    "storage",
    "offscreen"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "action": {
    "default_title": "Lens for Force of Will",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/toolbar16.png",
      "32": "icons/toolbar32.png",
      "48": "icons/toolbar48.png",
      "128": "icons/toolbar128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://*.youtube.com/*",
        "https://www.twitch.tv/*",
        "https://twitch.tv/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/lib/*.js",
        "icons/overlay_on.svg",
        "icons/overlay_off.svg"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://*.youtube.com/*",
        "https://www.twitch.tv/*",
        "https://twitch.tv/*"
      ]
    }
  ]
}
